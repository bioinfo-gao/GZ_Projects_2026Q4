/*
 * P51 — Lijian Wu mouse bulk RNA-seq. SOLO full-machine profile (server idle at launch,
 * 2026-11-07 22:23, load 0.3; no other pipeline running).
 * Budget: 56 threads / 108 GB (CLAUDE.md sustained cap 28 cores / 56 threads).
 * Derived from P30 config (proj30, the newest replicated RNAseq run); STAR sized for the
 * mouse GRCm39 index (~26-28 GB resident per task).
 *
 * PITFALL GUARD (software_pitfalls/nextflow.md, proj19): every generic label is covered —
 * process_single/low/medium/high/long/high_memory. An uncovered label silently inherits
 * nf-core base.config (12 cpus/task) and throttles concurrency.
 */
executor {
    cpus   = 56
    memory = '108 GB'
}

process {
    withName: '.*:STAR_ALIGN' {
        cpus     = 18
        memory   = 32.GB
        maxForks = 3
    }
    withName: '.*SALMON_QUANT' {
        cpus     = 7
        memory   = 12.GB
        maxForks = 6
    }
    withName: '.*TRIMGALORE.*' {
        cpus     = 6
        memory   = 10.GB
        maxForks = 6
    }
    withName: '.*SORTMERNA.*' {
        cpus     = 7
        memory   = 12.GB
        maxForks = 6
    }
    withLabel: process_single {
        cpus     = 1
        memory   = 6.GB
        maxForks = 24
    }
    withLabel: process_low {
        cpus     = 2
        memory   = 6.GB
        maxForks = 20
    }
    withLabel: process_medium {
        cpus     = 4
        memory   = 10.GB
        maxForks = 12
    }
    withLabel: process_high {
        cpus     = 12
        memory   = 30.GB
        maxForks = 4
    }
    withLabel: process_long {
        time = 48.h
    }
    withLabel: process_high_memory {
        memory = 100.GB
    }
}
